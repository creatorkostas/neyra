# Generated by scripts/prepare_aur.py from the tagged Linux release archive.
# Add your AUR Maintainer line before submitting this package.
@METADATA@

package() {
  install -Dm755 "${srcdir}/Neyra" "${pkgdir}/opt/neyra/Neyra"
  install -Dm755 "${srcdir}/neyra" "${pkgdir}/usr/bin/neyra"
  install -Dm644 "${srcdir}/neyra.desktop" "${pkgdir}/usr/share/applications/neyra.desktop"
  install -Dm644 "${srcdir}/neyra.svg" "${pkgdir}/usr/share/icons/hicolor/scalable/apps/neyra.svg"
  install -Dm644 "${srcdir}/LICENSE" "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
}
